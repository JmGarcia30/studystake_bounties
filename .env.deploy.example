# Deployment configuration for scripts/deploy.sh.
#
# Copy this file to .env.deploy and fill it in. .env.deploy is gitignored —
# never commit it. This file itself contains no secrets and is safe to
# commit; it documents the shape, not real values.
#
# See docs/DEPLOYMENT.md for the full walkthrough.

# --- Network -----------------------------------------------------------
# The script refuses anything other than "testnet" unless you also set
# DEPLOY_ALLOW_NON_TESTNET=1 below. This is a deliberate safety rail.
DEPLOY_NETWORK=testnet

# --- Identity ------------------------------------------------------------
# Name of a Stellar CLI identity created ahead of time with:
#   stellar keys generate deployer --fund --network testnet
# The script resolves this to a public address itself — never put a raw
# secret key or seed phrase anywhere in this file.
DEPLOY_SOURCE_IDENTITY=deployer

# Optional: admin address for both contracts. Defaults to the deployer
# identity's own address if left blank — matching how the Level 2 contract
# was initialized (admin = deployer).
DEPLOY_ADMIN_ADDRESS=

# --- Network overrides (optional) ----------------------------------------
# Leave blank to use the Stellar CLI's built-in "testnet" RPC default.
DEPLOY_RPC_URL=

# Set to 1 only if DEPLOY_NETWORK is intentionally not "testnet".
DEPLOY_ALLOW_NON_TESTNET=0

# --- Reference values (optional) ------------------------------------------
# Not used by any on-chain call the script makes — passed through into the
# deployment summary purely so you don't have to look it up separately when
# filling in frontend/.env afterward. Defaults to the testnet native-XLM SAC
# already used in frontend/.env.example.
DEPLOY_TOKEN_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# --- Reuse existing contracts (optional) ----------------------------------
# Leave both blank for a fresh deploy of both contracts. Set one or both to
# skip deploying that contract and reuse an already-deployed address
# instead — see docs/DEPLOYMENT.md "How to redeploy safely".
DEPLOY_REPUTATION_CONTRACT_ID=
DEPLOY_BOUNTY_CONTRACT_ID=

# --- Output locations (optional — defaults shown) -------------------------
BINDINGS_BOUNTIES_DIR=frontend/src/lib/bindings/studystake_bounties
BINDINGS_REPUTATION_DIR=frontend/src/lib/bindings/studystake_reputation
DEPLOYMENT_OUTPUT_DIR=.deployments
