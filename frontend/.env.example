# Public testnet configuration — no secrets belong in this file or in .env.
# Copy this file to .env and fill in the deployed contract address.

VITE_CONTRACT_ID=CCRBVQZ7IRASOIAQOWYYXV4UUJ2FPAVWMLULQW5KQBILXOXXFOMRXFA3

# Testnet native-XLM Stellar Asset Contract. Editable in the UI; used as the
# default escrow token so the demo flow works with just a friendbot-funded wallet.
VITE_TOKEN_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

VITE_RPC_URL=https://soroban-testnet.stellar.org
VITE_HORIZON_URL=https://horizon-testnet.stellar.org
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Current wired studystake_reputation Testnet contract. It remains optional at runtime;
# leave blank only when intentionally testing the reputation fallback state.
VITE_REPUTATION_CONTRACT_ID=CBFNKF5HOW5XJNH3DLTYUQADZI5C53BCDDLDYQ2PUFJE2IYAOLG7C32W

# Optional shared metadata persistence. When either value is blank, the app
# safely uses LocalBountyRepository instead. Never use a service-role key here.
VITE_SUPABASE_URL=<SUPABASE_PROJECT_URL>
VITE_SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>

# Optional production analytics. Public GA4 web-stream measurement ID.
# Leave blank to disable analytics without affecting the app.
VITE_GA_MEASUREMENT_ID=

# Optional production error monitoring. The browser DSN is public by design;
# never put a Sentry auth token in a VITE_ variable.
VITE_SENTRY_DSN=
VITE_APP_ENV=production
VITE_APP_RELEASE=
